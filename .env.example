# ────────────────────────────────────────────────────────────
# Swiggy LifeOS — Environment Variables (example for Vercel)
# ────────────────────────────────────────────────────────────
# Copy this to .env for local dev, or set in Vercel dashboard

# Base URL for OAuth redirects — set to your Vercel deployment URL in production
# Local dev: http://localhost:8080
LIFEOS_BASE_URL=

# Swiggy MCP Client ID (optional — DCR auto-registers if empty)
# SWIGGY_MCP_CLIENT_ID=

# Vercel preset (Nitro auto-detects when this is set)
# NITRO_PRESET=vercel
