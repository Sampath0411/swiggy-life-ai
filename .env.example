# ────────────────────────────────────────────────────────────
# Swiggy LifeOS — MCP Configuration
# ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# MCP servers use OAuth 2.1 + PKCE — no API key needed.

# Swiggy MCP Client ID (for Dynamic Client Registration)
# In most setups, the client registers itself automatically.
# Set this only if you have a pre-registered client ID.
# SWIGGY_MCP_CLIENT_ID=your-client-id

# Base URL for the LifeOS app (used in OAuth redirect URIs)
# For local development:
LIFEOS_BASE_URL=http://localhost:3000

# For production, set to your deployed URL:
# LIFEOS_BASE_URL=https://your-app.vercel.app

# ─── MCP Server URLs ────────────────────────────────────────
# These are the default Swiggy MCP endpoints.
# Override only if you're using a proxy or staging environment.

# FOOD_MCP_URL=https://mcp.swiggy.com/food
# INSTAMART_MCP_URL=https://mcp.swiggy.com/im
# DINEOUT_MCP_URL=https://mcp.swiggy.com/dineout
